        <mxCell id="cell-25" value="TH04: Chấp nhận → tạo hợp đồng chờ xác nhận, giữ phòng 48 giờ và tự tạo PDF; từ chối → ghi nhận lý do." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1303" width="1060" height="27" as="geometry" />
        </mxCell>
        <mxCell id="cell-26" value="TH06: Xác nhận thành công → hợp đồng có hiệu lực, phòng chuyển sang đã thuê." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1332" width="1060" height="27" as="geometry" />
        </mxCell>
        <mxCell id="cell-27" value="Quản trị viên chỉ đọc chi tiết yêu cầu và hợp đồng/PDF. Người thuê, chủ trọ truy cập dữ liệu theo quyền." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1361" width="1060" height="27" as="geometry" />
        </mxCell>
        <mxCell id="cell-28" value="«include» là hành vi bắt buộc. Đăng nhập là tiền điều kiện. Các hình cùng tên biểu diễn cùng một tác nhân." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1390" width="1060" height="27" as="geometry" />
