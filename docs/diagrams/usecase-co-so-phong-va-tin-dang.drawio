        <mxCell id="cell-27" value="TS01: Tạo cơ sở cùng phòng ban đầu, xem danh sách/chi tiết. TS02: Cập nhật địa chỉ và tọa độ." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1686" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="cell-28" value="TS03: Thêm, xem, sửa, xóa phòng theo điều kiện nghiệp vụ; quản lý giá, phí, trạng thái và ảnh." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1716" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="cell-29" value="TD01 / TD04: Kiểm tra quyền đăng, hạn mức, phòng còn cho thuê và tin hiệu lực cùng cơ sở; sau đó chờ duyệt." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1746" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="cell-30" value="QT01: Quản trị viên duyệt hoặc từ chối kèm lý do; tin chỉ công khai sau khi được duyệt." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1776" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="cell-31" value="«include»: bắt buộc; «extend»: tùy chọn. Đăng nhập là tiền điều kiện. Các hình Chủ trọ là cùng một tác nhân." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Arial;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="250" y="1806" width="1100" height="28" as="geometry" />
