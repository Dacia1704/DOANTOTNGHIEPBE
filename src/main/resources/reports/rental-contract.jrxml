<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="rental_contract" language="java" pageWidth="595" pageHeight="842"
              columnWidth="499" leftMargin="48" rightMargin="48" topMargin="36" bottomMargin="36">
    <property name="net.sf.jasperreports.export.pdf.force.linebreak.policy" value="true"/>
    <style name="Body" default="true" fontName="Noto Sans" fontSize="10.5"/>
    <style name="Heading" style="Body" bold="true" fontSize="11"/>
    <parameter name="agreementCode" class="java.lang.String"/>
    <parameter name="issuedDate" class="java.lang.String"/>
    <parameter name="address" class="java.lang.String"/>
    <parameter name="landlordName" class="java.lang.String"/>
    <parameter name="landlordCitizenId" class="java.lang.String"/>
    <parameter name="landlordCitizenIdIssuedDate" class="java.lang.String"/>
    <parameter name="landlordCitizenIdIssuedPlace" class="java.lang.String"/>
    <parameter name="landlordAddress" class="java.lang.String"/>
    <parameter name="landlordPhone" class="java.lang.String"/>
    <parameter name="landlordEmail" class="java.lang.String"/>
    <parameter name="tenantName" class="java.lang.String"/>
    <parameter name="tenantCitizenId" class="java.lang.String"/>
    <parameter name="tenantCitizenIdIssuedDate" class="java.lang.String"/>
    <parameter name="tenantCitizenIdIssuedPlace" class="java.lang.String"/>
    <parameter name="tenantAddress" class="java.lang.String"/>
    <parameter name="tenantPhone" class="java.lang.String"/>
    <parameter name="tenantEmail" class="java.lang.String"/>
    <parameter name="propertyName" class="java.lang.String"/>
    <parameter name="roomNumber" class="java.lang.String"/>
    <parameter name="roomType" class="java.lang.String"/>
    <parameter name="areaM2" class="java.lang.String"/>
    <parameter name="maxOccupants" class="java.lang.String"/>
    <parameter name="occupantCount" class="java.lang.String"/>
    <parameter name="durationMonths" class="java.lang.String"/>
    <parameter name="startDate" class="java.lang.String"/>
    <parameter name="endDate" class="java.lang.String"/>
    <parameter name="price" class="java.lang.String"/>
    <parameter name="priceInWords" class="java.lang.String"/>
    <parameter name="deposit" class="java.lang.String"/>
    <parameter name="depositInWords" class="java.lang.String"/>
    <parameter name="electricityPrice" class="java.lang.String"/>
    <parameter name="waterPrice" class="java.lang.String"/>
    <parameter name="serviceFee" class="java.lang.String"/>
    <parameter name="feeUnits" class="java.lang.String"/>
    <parameter name="paymentCycleMonths" class="java.lang.String"/>
    <parameter name="paymentDay" class="java.lang.String"/>
    <parameter name="terms" class="java.lang.String"/>
    <parameter name="landlordConfirmedAt" class="java.lang.String"/>
    <parameter name="tenantConfirmation" class="java.lang.String"/>
    <title height="108" splitType="Prevent">
        <element kind="staticText" x="0" y="0" width="499" height="20" bold="true" fontSize="12" hTextAlign="Center">
            <text><![CDATA[CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM]]></text>
        </element>
        <element kind="staticText" x="0" y="23" width="499" height="19" bold="true" hTextAlign="Center">
            <text><![CDATA[Độc lập - Tự do - Hạnh phúc]]></text>
        </element>
        <element kind="line" x="167" y="47" width="165" height="1">
            <pen lineWidth="0.6"/>
        </element>
        <element kind="staticText" x="0" y="60" width="499" height="25" bold="true" fontSize="16" hTextAlign="Center">
            <text><![CDATA[HỢP ĐỒNG THUÊ PHÒNG TRỌ]]></text>
        </element>
        <element kind="textField" x="0" y="88" width="499" height="18" fontSize="9" hTextAlign="Center">
            <expression><![CDATA["Mã hợp đồng: " + $P{agreementCode}]]></expression>
        </element>
    </title>
    <detail>
        <band height="42" splitType="Stretch">
            <element kind="textField" x="0" y="0" width="499" height="38" textAdjust="StretchHeight" hTextAlign="Justified">
                <expression><![CDATA["Hôm nay, " + $P{issuedDate} + ", tại căn nhà số " + $P{address} + ". Chúng tôi ký tên dưới đây gồm có:"]]></expression>
            </element>
        </band>
        <band height="104" splitType="Prevent">
            <element kind="staticText" style="Heading" x="0" y="2" width="499" height="20">
                <text><![CDATA[BÊN CHO THUÊ PHÒNG TRỌ (gọi tắt là Bên A):]]></text>
            </element>
            <element kind="textField" x="0" y="24" width="499" height="76" textAdjust="StretchHeight">
                <expression><![CDATA["Ông/bà (tên chủ hợp đồng): " + $P{landlordName}
+ "\nCMND/CCCD số: " + $P{landlordCitizenId} + "; cấp ngày: " + $P{landlordCitizenIdIssuedDate}
+ "; nơi cấp: " + $P{landlordCitizenIdIssuedPlace}
+ "\nThường trú tại: " + $P{landlordAddress}
+ "\nĐiện thoại: " + $P{landlordPhone} + "; Email: " + $P{landlordEmail}]]></expression>
            </element>
        </band>
        <band height="104" splitType="Prevent">
            <element kind="staticText" style="Heading" x="0" y="2" width="499" height="20">
                <text><![CDATA[BÊN THUÊ PHÒNG TRỌ (gọi tắt là Bên B):]]></text>
            </element>
            <element kind="textField" x="0" y="24" width="499" height="76" textAdjust="StretchHeight">
                <expression><![CDATA["Ông/bà: " + $P{tenantName}
+ "\nCMND/CCCD số: " + $P{tenantCitizenId} + "; cấp ngày: " + $P{tenantCitizenIdIssuedDate}
+ "; nơi cấp: " + $P{tenantCitizenIdIssuedPlace}
+ "\nThường trú tại: " + $P{tenantAddress}
+ "\nĐiện thoại: " + $P{tenantPhone} + "; Email: " + $P{tenantEmail}]]></expression>
            </element>
        </band>
        <band height="26">
            <element kind="staticText" x="0" y="2" width="499" height="20">
                <text><![CDATA[Sau khi thỏa thuận, hai bên thống nhất như sau:]]></text>
            </element>
        </band>
        <band height="130" splitType="Stretch">
            <element kind="staticText" style="Heading" x="0" y="2" width="499" height="20">
                <text><![CDATA[1. Nội dung thuê phòng trọ]]></text>
            </element>
            <element kind="textField" x="0" y="24" width="499" height="102" textAdjust="StretchHeight" hTextAlign="Justified">
                <expression><![CDATA["Bên A cho Bên B thuê 01 phòng trọ số " + $P{roomNumber} + " tại căn nhà số " + $P{address}
+ ". Cơ sở: " + $P{propertyName} + "; loại phòng: " + $P{roomType} + "; diện tích: " + $P{areaM2} + " m²."
+ "\nThời hạn thuê: " + $P{durationMonths} + " tháng, từ ngày " + $P{startDate} + " đến ngày " + $P{endDate} + "."
+ "\nGiá thuê: " + $P{price} + " đồng/tháng (Bằng chữ: " + $P{priceInWords} + "). Chưa bao gồm chi phí điện sinh hoạt, nước."
+ "\nGiá điện: " + $P{electricityPrice} + " đồng; giá nước: " + $P{waterPrice} + " đồng; phí dịch vụ: " + $P{serviceFee} + " đồng. " + $P{feeUnits}]]></expression>
            </element>
        </band>
        <band height="70" splitType="Prevent">
            <element kind="staticText" style="Heading" x="0" y="2" width="499" height="20">
                <text><![CDATA[2. Trách nhiệm Bên A]]></text>
            </element>
            <element kind="staticText" x="0" y="24" width="499" height="42">
                <text><![CDATA[- Đảm bảo căn nhà cho thuê không có tranh chấp, khiếu kiện.
- Đăng ký với chính quyền địa phương về thủ tục cho thuê phòng trọ.]]></text>
            </element>
        </band>
        <band height="88" splitType="Prevent">
            <element kind="staticText" style="Heading" x="0" y="2" width="499" height="20">
                <text><![CDATA[3. Trách nhiệm Bên B]]></text>
            </element>
            <element kind="textField" x="0" y="24" width="499" height="60" textAdjust="StretchHeight" hTextAlign="Justified">
                <expression><![CDATA["- Đặt cọc với số tiền là " + $P{deposit} + " đồng (Bằng chữ: " + $P{depositInWords}
+ "), thanh toán tiền thuê phòng vào ngày " + $P{paymentDay} + ", kỳ thanh toán " + $P{paymentCycleMonths} + " tháng, cộng tiền điện và nước."]]></expression>
            </element>
        </band>
        <band height="66" splitType="Stretch">
            <element kind="staticText" x="0" y="0" width="499" height="62" hTextAlign="Justified">
                <text><![CDATA[- Đảm bảo các thiết bị và sửa chữa các hư hỏng trong phòng trong khi sử dụng. Nếu không sửa chữa thì khi trả phòng, Bên A sẽ trừ vào tiền đặt cọc, giá trị cụ thể được tính theo giá thị trường.]]></text>
            </element>
        </band>
        <band height="112" splitType="Stretch">
            <element kind="textField" x="0" y="0" width="499" height="108" textAdjust="StretchHeight" hTextAlign="Justified">
                <expression><![CDATA["- Chỉ sử dụng phòng trọ vào mục đích ở, với số lượng tối đa không quá " + $P{maxOccupants}
+ " người (kể cả trẻ em); số người đăng ký: " + $P{occupantCount}
+ ". Không chứa các thiết bị gây cháy nổ, hàng cấm; cung cấp giấy tờ tùy thân để đăng ký tạm trú theo quy định, giữ gìn an ninh trật tự, nếp sống văn hóa đô thị; không tụ tập nhậu nhẹt, cờ bạc và các hành vi vi phạm pháp luật khác."]]></expression>
            </element>
        </band>
        <band height="66" splitType="Stretch">
            <element kind="staticText" x="0" y="0" width="499" height="62" hTextAlign="Justified">
                <text><![CDATA[- Không được tự ý cải tạo kiến trúc phòng hoặc trang trí ảnh hưởng tới tường, cột, nền. Nếu có nhu cầu trên phải trao đổi với Bên A để được thống nhất.]]></text>
            </element>
        </band>
        <band height="108" splitType="Prevent">
            <element kind="staticText" style="Heading" x="0" y="2" width="499" height="20">
                <text><![CDATA[4. Điều khoản thực hiện]]></text>
            </element>
            <element kind="textField" x="0" y="24" width="499" height="80" textAdjust="StretchHeight" hTextAlign="Justified">
                <expression><![CDATA["Hai bên nghiêm túc thực hiện những quy định trên trong thời hạn cho thuê. Nếu Bên A lấy phòng phải báo cho Bên B ít nhất 01 tháng, hoặc ngược lại."
+ "\nSau thời hạn cho thuê " + $P{durationMonths} + " tháng, nếu Bên B có nhu cầu, hai bên tiếp tục thương lượng giá thuê để gia hạn hợp đồng bằng miệng hoặc theo thỏa thuận của hai bên."]]></expression>
            </element>
        </band>
        <band height="54" splitType="Stretch">
            <printWhenExpression><![CDATA[!$P{terms}.isBlank()]]></printWhenExpression>
            <element kind="staticText" style="Heading" x="0" y="2" width="499" height="20">
                <text><![CDATA[Thỏa thuận bổ sung:]]></text>
            </element>
            <element kind="textField" x="0" y="24" width="499" height="26" textAdjust="StretchHeight" hTextAlign="Justified" markup="none">
                <expression><![CDATA[$P{terms}]]></expression>
            </element>
        </band>
    </detail>
    <pageFooter height="20">
        <element kind="textField" x="0" y="5" width="499" height="15" fontSize="8" hTextAlign="Right">
            <expression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
    <summary height="174" splitType="Prevent">
        <element kind="staticText" style="Heading" x="0" y="8" width="245" height="20" hTextAlign="Center">
            <text><![CDATA[BÊN CHO THUÊ (BÊN A)]]></text>
        </element>
        <element kind="staticText" style="Heading" x="254" y="8" width="245" height="20" hTextAlign="Center">
            <text><![CDATA[BÊN THUÊ (BÊN B)]]></text>
        </element>
        <element kind="staticText" x="0" y="30" width="245" height="18" fontSize="9" hTextAlign="Center">
            <text><![CDATA[(Ký, ghi rõ họ tên nếu ký bản giấy)]]></text>
        </element>
        <element kind="staticText" x="254" y="30" width="245" height="18" fontSize="9" hTextAlign="Center">
            <text><![CDATA[(Ký, ghi rõ họ tên nếu ký bản giấy)]]></text>
        </element>
        <element kind="textField" x="0" y="88" width="245" height="20" textAdjust="StretchHeight" hTextAlign="Center">
            <expression><![CDATA[$P{landlordName}]]></expression>
        </element>
        <element kind="textField" x="254" y="88" width="245" height="20" textAdjust="StretchHeight" hTextAlign="Center">
            <expression><![CDATA[$P{tenantName}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="116" width="499" height="54" textAdjust="StretchHeight" fontSize="8" markup="none">
            <expression><![CDATA["Ghi nhận đồng ý trong ứng dụng: Chủ trọ đồng ý lúc " + $P{landlordConfirmedAt} + ". " + $P{tenantConfirmation}
+ "\nĐây là ghi nhận đồng ý điện tử trong ứng dụng. Không phải chữ ký số được chứng thực. PDF được cố định khi phát hành; xác nhận sau đó không sửa nội dung PDF."]]></expression>
        </element>
    </summary>
</jasperReport>
